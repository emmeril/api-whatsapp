PORT=3000
API_TOKEN=ganti-dengan-token-rahasia-yang-panjang
SESSION_PATH=.wwebjs_auth
CLIENT_ID=main
AUTO_CONNECT=true

# Recovery otomatis jika WhatsApp Web atau Chromium macet/terputus.
RECONNECT_BASE_DELAY_MS=5000
RECONNECT_MAX_DELAY_MS=60000
WATCHDOG_INTERVAL_MS=30000
WHATSAPP_OPERATION_TIMEOUT_MS=30000

# Jeda acak antar pesan keluar. Isi keduanya 0 untuk menonaktifkan.
SEND_DELAY_MIN_MS=1000
SEND_DELAY_MAX_MS=3000

# Nomor lokal yang diawali 0 akan diubah ke kode negara ini.
DEFAULT_COUNTRY_CODE=62

# Opsional: executable Chromium/Chrome yang sudah terpasang.
# CHROME_EXECUTABLE_PATH=/usr/bin/google-chrome

# Command tersimpan persisten dalam file JSON ini.
COMMANDS_FILE=.data/commands.json

# Opsional: secret dikirim ke webhook melalui Bearer dan x-command-secret.
# COMMAND_WEBHOOK_SECRET=ganti-dengan-secret-webhook
COMMAND_WEBHOOK_TIMEOUT_MS=10000

# Opsional: pesan masuk yang bukan command diteruskan ke aplikasi lain,
# misalnya bot cashflow dengan pola `+10000 Gaji #bank` dan trigger grup.
# Kosongkan untuk mematikan penerusan pesan.
# MESSAGE_WEBHOOK_URL=http://localhost:3300/webhooks/whatsapp
# MESSAGE_WEBHOOK_SECRET=ganti-dengan-secret-webhook
MESSAGE_WEBHOOK_TIMEOUT_MS=10000
