PORT=3000
API_TOKEN=ganti-dengan-token-rahasia-yang-panjang
SESSION_PATH=.wwebjs_auth
CLIENT_ID=main
AUTO_CONNECT=true

# Nomor lokal yang diawali 0 akan diubah ke kode negara ini.
DEFAULT_COUNTRY_CODE=62

# Opsional: executable Chromium/Chrome yang sudah terpasang.
# CHROME_EXECUTABLE_PATH=/usr/bin/google-chrome
